#!/bin/sh
#
# PROVIDE: netboot_tftpd
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Custom rc.d wrapper for the os-netboot TFTP daemon. We do not use the
# tftp-hpa pkg's stock rc script because that one reads global /etc/rc.conf
# entries (tftpd_enable, tftpd_flags) which would conflict with anyone else
# who wants a tftpd. This wrapper has its own name and reads its config
# from a file rendered by the OPNsense template engine.
#

. /etc/rc.subr

name="netboot_tftpd"
rcvar="${name}_enable"
desc="os-netboot TFTP daemon"

pidfile="/var/run/${name}.pid"
flagsfile="/var/etc/netboot/tftpd-flags"
program="/usr/local/libexec/in.tftpd"

# The daemon(8) wrapper handles backgrounding and pidfile management uniformly
# across our three rc.d scripts (tftpd, lighttpd, sshd). This keeps the
# supervision model consistent regardless of whether the underlying daemon has
# its own daemonization story.
command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -t ${desc}"

start_precmd="${name}_precmd"

netboot_tftpd_precmd()
{
    if [ ! -r "${flagsfile}" ]; then
        warn "netboot_tftpd: cannot start: rendered in.tftpd flags file not readable at ${flagsfile}."
        warn "  Expected: a Jinja2-rendered file produced by 'configctl template reload OPNsense/Netboot',"
        warn "  containing the CLI flags (e.g. '-L -s /var/netboot -u nobody'). The template engine"
        warn "  writes this on every save of Services -> Netboot -> General."
        warn "  Fix: open the Netboot settings page in the GUI and click Save, OR run"
        warn "  'configctl netboot setup && configctl template reload OPNsense/Netboot' at the shell."
        return 1
    fi
    if [ ! -x "${program}" ]; then
        warn "netboot_tftpd: cannot start: in.tftpd binary not present or not executable at ${program}."
        warn "  Expected: /usr/local/libexec/in.tftpd, installed by the tftp-hpa package which"
        warn "  os-netboot declares as a PLUGIN_DEPENDS. Its absence means the dependency wasn't"
        warn "  installed, or has been removed."
        warn "  Fix: 'pkg install -y tftp-hpa' or reinstall the os-netboot plugin."
        return 1
    fi
    # Append the actual program and its args to command_args.
    command_args="${command_args} ${program} $(cat ${flagsfile})"
}

load_rc_config $name
: ${netboot_tftpd_enable:="YES"}

run_rc_command "$1"
